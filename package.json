{
  "name": "qunhao",
  "version": "1.0.0",
  "private": true,
  "description": "群号 - 稳定的群二维码链接服务（Cloudflare Pages + Workers）",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute qunhao-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute qunhao-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260610.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
