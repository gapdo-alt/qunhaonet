{
	// Cloudflare Pages 项目配置（Pages Functions + D1 + R2 + KV）
	"name": "qunhao",
	"compatibility_date": "2026-06-01",
	"pages_build_output_dir": "public",
	"vars": {
		// 对外域名（用于预渲染页面里的 og:image 绝对地址）
		"PUBLIC_HOST": "qunhao.net"
		// 首个管理员：wrangler pages secret put ADMIN_EMAIL（本地见 .dev.vars）
		// Turnstile：wrangler pages secret put TURNSTILE_SECRET_KEY（本地见 .dev.vars）
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "qunhao-db",
			"database_id": "4afe810a-bda9-49f6-a0e0-a148fc21fb6f"
		}
	],
	"r2_buckets": [
		{
			"binding": "QR_BUCKET",
			"bucket_name": "qunhao-qr"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "e4f3077d50e6459c8ab5f666a951eebe"
		}
	]
}
